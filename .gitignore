# dependencies
node_modules/

# OS / editor
.DS_Store
Thumbs.db
*.log

# build scratch (keep dist/ committed — CI verifies it)
*.tmp

# python cache (build_docs.py)
__pycache__/
*.pyc

# playwright artifacts (baselines under tests/**-snapshots ARE committed)
test-results/
playwright-report/
# failure debris: Playwright writes <test-title>-chromium/ dirs with
# -actual/-diff/-expected PNGs plus error-context.md. Ten of these were
# committed by accident; never again.
tests/*-chromium/
tests/*-firefox/
tests/*-webkit/
